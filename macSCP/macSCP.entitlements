<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  App Sandbox is intentionally disabled: importing ~/.ssh/config requires
	  reading the user's ssh config and private keys, which a sandboxed app
	  cannot do reliably (security-scoped bookmarks would break on every Include
	  outside ~/.ssh). The app is distributed outside the App Store, so the
	  sandbox is not required.
	-->
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.macSCP.keychain</string>
	</array>
</dict>
</plist>
